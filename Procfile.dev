envtest: bin/dev-envtest --assets="$KUBEBUILDER_ASSETS" --crds=deploy/crds --output-kubeconfig="$DEV_ROOT/kubeconfig" --service-account-key="$DEV_ROOT/service-account.key"
s3: weed mini -dir="${SOURCEGATEWAY_DEV_S3_STORAGE:-$DEV_ROOT/weed}" -ip=127.0.0.1 -ip.bind=127.0.0.1 -s3.port=8333 -filer.port=8888 -master.port=9333 -volume.port=18081 -master.telemetry=false
git: bin/dev-git --root="$DEV_ROOT/git" --certificate="$DEV_ROOT/tls.crt" --key="$DEV_ROOT/tls.key"
sourcegateway: scripts/dev/run.sh
